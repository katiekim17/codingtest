# 한번 더 풀었는데도 기억이 잘 안나던 문제

class Solution(object):
    def numIslands(self, grid):
        """
        :type grid: List[List[str]]
        :rtype: int
        """
        if not grid:
            return 0

        rows = len(grid)
        cols = len(grid[0])
        island_count = 0

        def dfs(r, c):
            # 격자 밖으로 넘어가거나 1이 아니면 종료
            if r < 0 or r >= rows or c < 0 or c >= cols or grid[r][c] != '1':
                return
            # 방문한 땅은 0으로 바꾸기
            grid[r][c] = '0'

            dfs(r-1, c)
            dfs(r+1, c)
            dfs(r, c-1)
            dfs(r, c+1)


        for r in range(rows):
            for c in range(cols):
                if grid[r][c] == '1':
                    island_count += 1 # 섬 발견
                    dfs(r,c) # 주변땅도 확인, 상하좌우
        return island_count
        